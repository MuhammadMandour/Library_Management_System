  "item": [
    {
      "name": "Authors",
      "item": [
        {
          "name": "Create Author (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('createdAuthorId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{authorFirstName}}\",\n  \"lastName\": \"{{authorLastName}}\",\n  \"nationality\": \"{{authorNationality}}\",\n  \"birthDate\": \"{{authorBirthDate}}\"\n}"
            },
            "url": "{{baseUrl}}/api/authors"
          }
        },
        {
          "name": "Get All Authors (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/authors?page=0&size=10&sort=lastName,asc"
          }
        },
        {
          "name": "Get Author By ID (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/authors/{{createdAuthorId}}"
          }
        },
        {
          "name": "Update Author (200)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nelle\",\n  \"lastName\": \"Lee\",\n  \"nationality\": \"American\",\n  \"birthDate\": \"1926-04-28\"\n}"
            },
            "url": "{{baseUrl}}/api/authors/{{createdAuthorId}}"
          }
        },
        {
          "name": "Get Books By Author (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/authors/{{createdAuthorId}}/books"
          }
        },
        {
          "name": "Get Author By Missing ID (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/authors/{{missingId}}"
          }
        },
        {
          "name": "Delete Author Missing ID (404)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/authors/{{missingId}}"
          }
        }
      ]
    },

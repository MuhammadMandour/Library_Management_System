    { "key": "createdBookId", "value": "" },
    { "key": "createdMemberId", "value": "" },
    { "key": "createdBorrowRecordId", "value": "" },
    { "key": "authorFirstName", "value": "Harper" },
    { "key": "authorLastName", "value": "Lee" },
    { "key": "authorNationality", "value": "American" },
    { "key": "authorBirthDate", "value": "1926-04-28" },
    { "key": "bookTitle", "value": "To Kill a Mockingbird" },
    { "key": "bookIsbn", "value": "9780061120084" },
    { "key": "bookGenre", "value": "Fiction" },
    { "key": "bookYear", "value": "1960" },
    { "key": "memberFirstName", "value": "John" },
    { "key": "memberLastName", "value": "Reader" },

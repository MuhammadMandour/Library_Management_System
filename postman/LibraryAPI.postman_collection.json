              "raw": "{\n  \"title\": \"Duplicate ISBN Book\",\n  \"isbn\": \"{{bookIsbn}}\",\n  \"genre\": \"Test\",\n  \"publishedYear\": 2024,\n  \"authorId\": {{createdAuthorId}}\n}"
            },
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Get Book By Missing ID (404)",
          "request": {
            "method": "GET",
